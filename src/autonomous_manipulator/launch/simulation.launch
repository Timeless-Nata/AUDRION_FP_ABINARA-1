<launch>
  <!-- gui:=false hides the MuJoCo window (an OpenGL context is still needed: use xvfb-run on a headless machine) -->
  <arg name="gui" default="true"/>
  <arg name="model" default="$(find autonomous_manipulator)/models/arm_gripper_dumbbells.xml"/>

  <!-- All nodes run on simulation time: mujoco_sim_node publishes /clock. -->
  <param name="/use_sim_time" value="true"/>
  <rosparam command="load" file="$(find autonomous_manipulator)/config/mission.yaml"/>

  <node pkg="autonomous_manipulator" type="mujoco_sim_node" name="mujoco_sim" output="screen" required="true">
    <param name="model_path" value="$(arg model)"/>
    <param name="gui" value="$(arg gui)"/>
  </node>

  <node pkg="autonomous_manipulator" type="perception_node" name="perception" output="screen"/>

  <node pkg="autonomous_manipulator" type="mission_controller" name="mission_controller" output="screen" required="true">
    <param name="model_path" value="$(arg model)"/>
  </node>
</launch>
